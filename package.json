{
  "name": "pi-auditor",
  "version": "0.1.0",
  "type": "module",
  "description": "Pi coding agent extension for auditing tool calls with a rule engine",
  "scripts": {
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "format": "prettier --write '**/*.ts' '**/*.md'",
    "format:check": "prettier --check '**/*.ts' '**/*.md'",
    "lint": "eslint ."
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "dependencies": {
    "@marcbachmann/cel-js": "^7.6.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.2"
  }
}
